[
  { "name": "win: absolute entry is found", "platform": "win32", "PATH": "C:\\tools;C:\\real", "PATHEXT": ".COM;.EXE;.BAT;.CMD", "files": ["C:\\real\\git.EXE"], "name_to_find": "git", "expect": { "path": "C:\\real\\git.EXE", "batch": null } },
  { "name": "win: PATHEXT order decides within one directory", "platform": "win32", "PATH": "C:\\real", "PATHEXT": ".COM;.EXE;.BAT;.CMD", "files": ["C:\\real\\git.EXE", "C:\\real\\git.COM"], "name_to_find": "git", "expect": { "path": "C:\\real\\git.COM", "batch": null } },
  { "name": "win: a custom PATHEXT order is honoured", "platform": "win32", "PATH": "C:\\real", "PATHEXT": ".EXE;.COM", "files": ["C:\\real\\git.EXE", "C:\\real\\git.COM"], "name_to_find": "git", "expect": { "path": "C:\\real\\git.EXE", "batch": null } },
  { "name": "win: directory order beats extension order", "platform": "win32", "PATH": "C:\\first;C:\\second", "PATHEXT": ".COM;.EXE;.BAT;.CMD", "files": ["C:\\first\\git.EXE", "C:\\second\\git.COM"], "name_to_find": "git", "expect": { "path": "C:\\first\\git.EXE", "batch": null } },
  { "name": "win: dot is not searched", "platform": "win32", "PATH": ".;C:\\real", "PATHEXT": ".EXE", "files": [".\\git.EXE", "git.EXE", "C:\\real\\git.EXE"], "name_to_find": "git", "expect": { "path": "C:\\real\\git.EXE", "batch": null } },
  { "name": "win: empty entries are not searched", "platform": "win32", "PATH": ";C:\\real;", "PATHEXT": ".EXE", "files": ["\\git.EXE", "git.EXE", ".\\git.EXE", "C:\\real\\git.EXE"], "name_to_find": "git", "expect": { "path": "C:\\real\\git.EXE", "batch": null } },
  { "name": "win: only relative entries finds nothing", "platform": "win32", "PATH": ".;..;bin;.\\bin;..\\bin", "PATHEXT": ".EXE", "files": [".\\git.EXE", "..\\git.EXE", "bin\\git.EXE", ".\\bin\\git.EXE", "..\\bin\\git.EXE", "git.EXE"], "name_to_find": "git", "expect": { "path": null, "batch": null } },
  { "name": "win: drive-relative and root-relative entries depend on the cwd, so are not absolute", "platform": "win32", "PATH": "C:foo;\\foo;/foo", "PATHEXT": ".EXE", "files": ["C:foo\\git.EXE", "\\foo\\git.EXE", "/foo\\git.EXE"], "name_to_find": "git", "expect": { "path": null, "batch": null } },
  { "name": "win: an unexpanded variable is not absolute", "platform": "win32", "PATH": "%TOOLS%\\bin", "PATHEXT": ".EXE", "files": ["%TOOLS%\\bin\\git.EXE"], "name_to_find": "git", "expect": { "path": null, "batch": null } },
  { "name": "win: quotes around an entry are removed", "platform": "win32", "PATH": "\"C:\\Program Files\\Git\\cmd\"", "PATHEXT": ".EXE", "files": ["C:\\Program Files\\Git\\cmd\\git.EXE"], "name_to_find": "git", "expect": { "path": "C:\\Program Files\\Git\\cmd\\git.EXE", "batch": null } },
  { "name": "win: a trailing separator and forward slashes are accepted", "platform": "win32", "PATH": "C:/real/", "PATHEXT": ".EXE", "files": ["C:/real\\git.EXE"], "name_to_find": "git", "expect": { "path": "C:/real\\git.EXE", "batch": null } },
  { "name": "win: a UNC entry is absolute", "platform": "win32", "PATH": "\\\\server\\share\\bin", "PATHEXT": ".EXE", "files": ["\\\\server\\share\\bin\\git.EXE"], "name_to_find": "git", "expect": { "path": "\\\\server\\share\\bin\\git.EXE", "batch": null } },
  { "name": "win: a batch file is skipped for a real executable later on PATH", "platform": "win32", "PATH": "C:\\wrap;C:\\real", "PATHEXT": ".COM;.EXE;.BAT;.CMD", "files": ["C:\\wrap\\git.CMD", "C:\\real\\git.EXE"], "name_to_find": "git", "expect": { "path": "C:\\real\\git.EXE", "batch": "C:\\wrap\\git.CMD" } },
  { "name": "win: batch files alone resolve to nothing, and are named", "platform": "win32", "PATH": "C:\\wrap;C:\\other", "PATHEXT": ".COM;.EXE;.BAT;.CMD", "files": ["C:\\wrap\\git.BAT", "C:\\other\\git.CMD"], "name_to_find": "git", "expect": { "path": null, "batch": "C:\\wrap\\git.BAT" } },
  { "name": "win: script extensions in PATHEXT are not runnable", "platform": "win32", "PATH": "C:\\real", "PATHEXT": ".VBS;.JS;.PY", "files": ["C:\\real\\git.VBS", "C:\\real\\git.JS", "C:\\real\\git.PY"], "name_to_find": "git", "expect": { "path": null, "batch": null } },
  { "name": "win: PATHEXT defaults when absent", "platform": "win32", "PATH": "C:\\real", "PATHEXT": null, "files": ["C:\\real\\git.EXE"], "name_to_find": "git", "expect": { "path": "C:\\real\\git.EXE", "batch": null } },
  { "name": "win: an extensionless file is not an executable", "platform": "win32", "PATH": "C:\\real", "PATHEXT": ".EXE", "files": ["C:\\real\\git"], "name_to_find": "git", "expect": { "path": null, "batch": null } },
  { "name": "win: a name that already has its extension gets none added", "platform": "win32", "PATH": "C:\\real", "PATHEXT": ".COM;.EXE", "files": ["C:\\real\\git.exe"], "name_to_find": "git.exe", "expect": { "path": "C:\\real\\git.exe", "batch": null } },
  { "name": "win: an empty PATH finds nothing", "platform": "win32", "PATH": "", "PATHEXT": ".EXE", "files": ["git.EXE", ".\\git.EXE", "\\git.EXE"], "name_to_find": "git", "expect": { "path": null, "batch": null } },
  { "name": "posix: absolute entry is found", "platform": "linux", "PATH": "/opt/none:/usr/bin", "PATHEXT": null, "files": ["/usr/bin/git"], "name_to_find": "git", "expect": { "path": "/usr/bin/git", "batch": null } },
  { "name": "posix: the first absolute entry wins", "platform": "linux", "PATH": "/first:/second", "PATHEXT": null, "files": ["/second/git", "/first/git"], "name_to_find": "git", "expect": { "path": "/first/git", "batch": null } },
  { "name": "posix: dot is not searched", "platform": "linux", "PATH": ".:/usr/bin", "PATHEXT": null, "files": ["./git", "git", "/usr/bin/git"], "name_to_find": "git", "expect": { "path": "/usr/bin/git", "batch": null } },
  { "name": "posix: empty entries are not searched", "platform": "linux", "PATH": "::/usr/bin:", "PATHEXT": null, "files": ["/git", "git", "./git", "/usr/bin/git"], "name_to_find": "git", "expect": { "path": "/usr/bin/git", "batch": null } },
  { "name": "posix: only relative entries finds nothing", "platform": "linux", "PATH": ".:..:bin:./bin", "PATHEXT": null, "files": ["./git", "../git", "bin/git", "./bin/git", "git"], "name_to_find": "git", "expect": { "path": null, "batch": null } },
  { "name": "posix: a root entry joins cleanly", "platform": "linux", "PATH": "/", "PATHEXT": null, "files": ["/git"], "name_to_find": "git", "expect": { "path": "/git", "batch": null } },
  { "name": "posix: no extension is ever appended", "platform": "linux", "PATH": "/usr/bin", "PATHEXT": ".EXE", "files": ["/usr/bin/git.EXE"], "name_to_find": "git", "expect": { "path": null, "batch": null } },
  { "name": "posix: an empty PATH finds nothing", "platform": "linux", "PATH": "", "PATHEXT": null, "files": ["git", "./git", "/git"], "name_to_find": "git", "expect": { "path": null, "batch": null } }
]
